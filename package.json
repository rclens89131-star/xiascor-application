{
  "name": "sorare-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_ENV='development'; npx expo start\"",
    "start:preview": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_ENV='preview'; npx expo start\"",
    "build:preview:ios": "npx eas-cli build -p ios --profile preview",
    "build:preview:android": "npx eas-cli build -p android --profile preview",
    "build:prod:ios": "npx eas-cli build -p ios --profile production",
    "build:prod:android": "npx eas-cli build -p android --profile production",
    "guard:start:lan": "node ./scripts/ensure-project-root.js && expo start --lan",
    "guard:export:web": "node ./scripts/ensure-project-root.js && expo export --platform web",
    "guard:tsc": "node ./scripts/ensure-project-root.js && tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~55.0.31",
    "expo-auth-session": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
