{
  "name": "sorare-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_ENV='development'; npx expo start\"",
    "start:preview": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:EXPO_PUBLIC_APP_ENV='preview'; npx expo start\"",
    "build:preview:ios": "npx eas-cli build -p ios --profile preview",
    "build:preview:android": "npx eas-cli build -p android --profile preview",
    "build:prod:ios": "npx eas-cli build -p ios --profile production",
    "build:prod:android": "npx eas-cli build -p android --profile production",
    "guard:start:lan": "node ./scripts/ensure-project-root.js && expo start --lan",
    "guard:export:web": "node ./scripts/ensure-project-root.js && expo export --platform web",
    "guard:tsc": "node ./scripts/ensure-project-root.js && tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
