{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_BASE_URL": "http://127.0.0.1:3000",
        "EXPO_PUBLIC_AUTH_BASE_URL": "http://127.0.0.1:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_BASE_URL": "https://xiascor-backend-tssdy62zqa-ez.a.run.app",
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://xiascor-backend-tssdy62zqa-ez.a.run.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_BASE_URL": "https://xiascor-backend-tssdy62zqa-ez.a.run.app",
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://xiascor-backend-tssdy62zqa-ez.a.run.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
